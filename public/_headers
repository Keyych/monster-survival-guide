# Cloudflare Pages headers.

# Security headers applied site-wide. These are safe alongside AdSense:
# X-Frame-Options restricts others framing US, not our ads framing into the
# page. (A Content-Security-Policy is intentionally omitted — it needs careful
# allowlisting of Google's ad domains and is better rolled out report-only.)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.googleadservices.com https://*.google.com https://*.doubleclick.net https://*.gstatic.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://challenges.cloudflare.com; connect-src 'self' https://*.google.com https://*.doubleclick.net https://*.googlesyndication.com https://pagead2.googlesyndication.com https://challenges.cloudflare.com https://cloudflareinsights.com

# Astro fingerprints everything under /_astro/ (CSS, JS, fonts, processed
# images), so those URLs are content-addressed and safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pre-rendered Open Graph images change only when content/slug changes; a day
# of browser caching is plenty and keeps regenerated ones fresh.
/og/*
  Cache-Control: public, max-age=86400
