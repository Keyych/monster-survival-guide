---
import { sectionId } from '../lib/entry-sections.ts';
interface Props {
  heading: string;
  /** Heading level. Defaults to h2 — bump if nesting deeper. */
  level?: 2 | 3 | 4;
}
const { heading, level = 2 } = Astro.props;
const Heading = `h${level}` as const;
---

<section class="section" id={sectionId(heading)} aria-labelledby={`${sectionId(heading)}-heading`}>
  <Heading class="section-head" id={`${sectionId(heading)}-heading`} tabindex="-1"
    >{heading}</Heading
  >
  <slot />
</section>
