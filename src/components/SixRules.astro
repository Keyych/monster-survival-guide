---
interface Rule {
  /** Bold lead-in (e.g. "Maintain your fire at all costs."). Sentence — period included. */
  title: string;
  /** Body — the rule's explanation. */
  body: string;
}
interface Props {
  rules: Rule[];
  title?: string;
  number?: string;
  pocketHref?: string;
}
const { rules, pocketHref } = Astro.props;
---

<div class="notebook-rules">
  <ol class="rules-list">
    {
      rules.map((rule, i) => (
        <li>
          <span class="rule-num" aria-hidden="true">
            {i + 1}
          </span>
          <span>
            <strong>{rule.title}</strong> {rule.body}
          </span>
        </li>
      ))
    }
  </ol>
  {
    pocketHref && (
      <p class="rules-note">
        <em>Keep these close.</em> <a href={pocketHref}>Print pocket guide ↗</a>
      </p>
    )
  }
</div>
