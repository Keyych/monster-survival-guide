---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import FieldManual from '../../layouts/FieldManual.astro';
import EntryHeader from '../../components/EntryHeader.astro';
import EntryNavigation from '../../components/EntryNavigation.astro';
import { entrySections } from '../../lib/entry-sections.ts';
import { readingStats } from '../../lib/reading-time.ts';
import '../../styles/entry-reading.css';

export async function getStaticPaths() {
  // Only drafts — published entries already render at /<slug>/.
  const drafts = await getCollection('monsters', ({ data }) => data.status === 'draft');
  return drafts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'monsters'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const stats = readingStats(entry.body ?? '');
const sections = entrySections(entry.body ?? '');
---

<FieldManual
  variant="entry"
  title={`DRAFT — ${data.title}`}
  description={`Internal draft preview: ${data.description}`}
  classification={`draft preview  —  ${data.title.toLowerCase()}  —  not published`}
  bottomBar="monster survival guide  ·  draft preview  ·  not for public distribution"
  status="Draft"
  noindex
>
  <article class="entry-content">
    <a class="entry-back" href="/drafts/">← Back to drafts queue</a>
    <aside class="draft-banner" aria-label="Draft status">
      <strong>Draft — awaiting research.</strong>
      Prose, rules, and encounter records are placeholders. This preview is excluded from public indexes
      and search engines.
    </aside>
    <EntryHeader entry={entry} stats={stats} />
    <EntryNavigation sections={sections} />
    <Content />
  </article>
</FieldManual>

<style>
  .draft-banner {
    font-family: 'Anonymous Pro', monospace;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--warn);
    background: color-mix(in srgb, var(--warn) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--warn) 30%, transparent);
    border-left-width: 4px;
    padding: 14px 18px;
    margin-bottom: 32px;
  }
</style>
