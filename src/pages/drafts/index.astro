---
import { getCollection } from 'astro:content';
import FieldManual from '../../layouts/FieldManual.astro';
import InkIllustration from '../../components/InkIllustration.astro';
import { recordLabels } from '../../lib/entry-sections.ts';
import '../../styles/pages/entries.css';

const drafts = (await getCollection('monsters', ({ data }) => data.status === 'draft')).sort(
  (a, b) => parseInt(a.data.number, 10) - parseInt(b.data.number, 10),
);
---

<FieldManual
  variant="index"
  title="Drafts (Internal)"
  description="Unpublished notebook entries. Text and sources are still being worked on."
  classification="monster survival guide  —  drafts  —  internal"
  bottomBar="monster survival guide  ·  unfinished notes  ·  not for public distribution"
  status="Draft"
  noindex
>
  <header class="index-heading">
    <div class="index-topline">
      <span>Unfinished notebook</span><a href="/entries/">Published entries ↗</a>
    </div>
    <h1>Still in the margins.</h1>
    <p>{drafts.length} draft entries. Text, rules, and sources are still being worked on.</p>
  </header>
  <label class="filter-search" for="draft-search">
    <span class="visually-hidden">Search draft entries</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" class="filter-search-icon"
      ><circle cx="11" cy="11" r="6" fill="none" stroke="currentColor" stroke-width="2"
      ></circle><path d="m15.5 15.5 4.5 4.5" stroke="currentColor" stroke-width="2"></path></svg
    >
    <input
      id="draft-search"
      type="search"
      placeholder="Search unfinished notes…"
      autocomplete="off"
      data-draft-search
    />
    <button
      type="button"
      class="filter-search-clear"
      data-draft-clear
      aria-label="Clear search"
      hidden>×</button
    >
  </label>
  <div class="index-toolbar">
    <details class="index-filters">
      <summary>About these drafts</summary>
      <p class="draft-guidance">
        These notes and their pocket-guide previews are unpublished and excluded from the public
        index, sitemap, and feeds. Complete the writing and check the sources before publishing.
      </p>
    </details>
    <p class="index-count" role="status" aria-live="polite" data-draft-count>
      {drafts.length} drafts
    </p>
  </div>
  <p class="filter-empty" data-draft-empty hidden>No draft entries match this search.</p>
  <h2 class="visually-hidden">All draft entries</h2>
  <div class="entry-list">
    {
      drafts.map((entry) => (
        <a
          class="entry-card"
          href={`/drafts/${entry.id}/`}
          data-draft-card
          data-search-text={[
            entry.data.title,
            entry.data.description,
            entry.data.entryClass,
            entry.data.region,
            ...entry.data.tags,
          ]
            .join(' ')
            .toLowerCase()}
        >
          <div class="entry-band" style={`background:${entry.data.bandColor}`} />
          {entry.data.illustration && (
            <figure class="index-study">
              <InkIllustration src={entry.data.illustration.src} alt="" width={140} />
            </figure>
          )}
          <div class="entry-body">
            <div class="entry-label">
              Draft {entry.data.number} · {entry.data.entryClass}
            </div>
            <h3 class="entry-title">{entry.data.title}</h3>
            <div class="entry-desc">{entry.data.description}</div>
            <div class="entry-summary">
              <span>{entry.data.region}</span>
              {entry.data.recordKind && <span>{recordLabels[entry.data.recordKind]}</span>}
            </div>
          </div>
          <div class="entry-right">
            <div class="entry-arrow">→</div>
          </div>
        </a>
      ))
    }
  </div>
</FieldManual>
<style>
  .draft-guidance {
    font-size: 0.9rem;
    margin: 12px 0 0;
    max-width: 50ch;
  }
</style>
<script>
  const input = document.querySelector<HTMLInputElement>('[data-draft-search]');
  const clear = document.querySelector<HTMLButtonElement>('[data-draft-clear]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-draft-card]')];
  const count = document.querySelector<HTMLElement>('[data-draft-count]');
  const empty = document.querySelector<HTMLElement>('[data-draft-empty]');
  function filter() {
    const query = input?.value.trim().toLocaleLowerCase() ?? '';
    let visible = 0;
    for (const card of cards) {
      card.hidden = !query.split(/\s+/).every((word) => card.dataset.searchText?.includes(word));
      if (!card.hidden) visible++;
    }
    if (count)
      count.textContent = query ? `${visible} of ${cards.length} drafts` : `${cards.length} drafts`;
    if (clear) clear.hidden = !query;
    if (empty) empty.hidden = visible > 0;
  }
  input?.addEventListener('input', filter);
  clear?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      filter();
      input.focus();
    }
  });
</script>
