---
import { getCollection, type CollectionEntry } from 'astro:content';
import PocketGuide from '../../layouts/PocketGuide.astro';

export async function getStaticPaths() {
  const now = new Date();
  return (
    await getCollection(
      'monsters',
      ({ data }) =>
        data.status === 'published' &&
        !!data.rules &&
        (!data.publishDate || data.publishDate <= now),
    )
  ).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'monsters'>;
}
const { entry } = Astro.props;
---

<PocketGuide entry={entry} />
