---
import { getCollection, type CollectionEntry } from 'astro:content';
import { site } from '../../config/site.ts';
import { recordLabels } from '../../lib/entry-sections.ts';
import InkIllustration from '../../components/InkIllustration.astro';
import NotebookMotion from '../../components/NotebookMotion.astro';
import '../../styles/field-manual.css';
import '@fontsource/sorts-mill-goudy/400.css';
import '@fontsource/anonymous-pro/400.css';

export async function getStaticPaths() {
  const now = new Date();
  return (
    await getCollection(
      'monsters',
      ({ data }) =>
        data.status === 'published' &&
        !!data.rules &&
        (!data.publishDate || data.publishDate <= now),
    )
  ).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props {
  entry: CollectionEntry<'monsters'>;
}
const { entry } = Astro.props;
const { data } = entry;
const entryUrl = new URL(`/${entry.id}/`, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <NotebookMotion />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{data.title} — Six Rules Pocket Guide</title>
    <meta
      name="description"
      content={`A printable A5 pocket guide to the six folklore survival rules for ${data.title}.`}
    />
    <link rel="canonical" href={new URL(`/pocket/${entry.id}/`, site.url).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#pocket-sheet">Skip to main content</a>
    <div class="document" data-notebook-page>
      <div class="doc-inner">
        <nav class="print-toolbar" aria-label="Pocket guide actions">
          <a href={`/${entry.id}/#six-rules`}>← Back to the entry</a>
          <button type="button" data-print>Print / Save PDF</button>
          <p>A5 portrait · Print at 100% · Disable browser headers and footers</p>
        </nav>
        <main class="pocket-sheet" id="pocket-sheet" tabindex="-1">
          <header class="pocket-heading">
            <div>
              <p class="eyebrow">Monster Survival Guide / {data.number}</p>
              <h1>{data.title}</h1>
              <p class="subtitle">Six rules. Keep them close.</p>
              <p class="record">
                {data.recordKind && recordLabels[data.recordKind]} · Story-world danger {
                  data.danger
                }/10
              </p>
            </div>
            {
              data.illustration && (
                <figure>
                  <InkIllustration
                    src={data.illustration.src}
                    alt={data.illustration.alt}
                    width={160}
                    loading="eager"
                  />
                </figure>
              )
            }
          </header>
          <ol class="pocket-rules">
            {
              data.rules?.map((rule, index) => (
                <li>
                  <>
                    <span class="rule-number" aria-hidden="true">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <>
                        <h2>{rule.title}</h2>
                        <p>{rule.body}</p>
                      </>
                    </div>
                  </>
                </li>
              ))
            }
          </ol>
          <footer>
            <p>
              Folklore and storytelling · The rules are part of the guide’s narrative, not verified
              safety advice.
            </p>
            <a href={entryUrl}>{entryUrl.replace('https://', '')}</a>
          </footer>
        </main>
      </div>
    </div>
    <script>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
<style>
  :global(:root) {
    --paper: #f6f1e6;
    --ink: #25221c;
    --faded: #585247;
    --warn: #704534;
    --rule: rgba(37, 34, 28, 0.13);
  }

  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    color: #25221c;
    font-family: 'Sorts Mill Goudy', Georgia, serif;
  }
  .print-toolbar {
    max-width: none;
    margin: 0 auto 22px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    font:
      13px/1.5 'Anonymous Pro',
      monospace;
  }
  a {
    color: inherit;
    text-underline-offset: 3px;
  }
  button {
    font: inherit;
    padding: 12px 18px;
    border: 1px solid #25221c;
    background: #25221c;
    color: #f6f1e6;
    cursor: pointer;
  }
  .print-toolbar p {
    flex-basis: 100%;
    margin: 0;
    font-size: 12px;
  }
  .pocket-sheet {
    max-width: none;
    margin: auto;
    background: transparent;
    padding: 0;
  }
  .pocket-heading {
    display: grid;
    grid-template-columns: 1fr 130px;
    gap: 20px;
    align-items: center;
    border-bottom: 2px solid #25221c;
    padding-bottom: 16px;
  }
  .eyebrow,
  .record {
    font:
      11px/1.5 'Anonymous Pro',
      monospace;
    margin: 0 0 12px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  h1 {
    font-size: 36px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .subtitle {
    margin: 0 0 12px;
    font-size: 19px;
  }
  .record {
    margin: 0;
    color: #585247;
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .pocket-rules {
    list-style: none;
    margin: 12px 0;
    padding: 0;
  }
  .pocket-rules li {
    display: flex;
    gap: 16px;
    padding: 15px 0;
    border-bottom: 1px solid #c7bfae;
    break-inside: avoid;
  }
  .pocket-rules li:last-child {
    border: 0;
  }
  .rule-number {
    font-size: 28px;
    color: #704534;
    min-width: 31px;
    line-height: 1.15;
  }
  h2 {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 4px;
  }
  .pocket-rules p {
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }
  footer {
    border-top: 2px solid #25221c;
    padding-top: 14px;
    font:
      10px/1.5 'Anonymous Pro',
      monospace;
  }
  footer p {
    margin: 0 0 6px;
    font: inherit;
  }
  footer a {
    overflow-wrap: anywhere;
  }
  @media (max-width: 500px) {
    .pocket-heading {
      grid-template-columns: 1fr 80px;
      gap: 8px;
    }
    h1 {
      font-size: 28px;
    }
    .pocket-rules li {
      gap: 12px;
    }
  }
  @page {
    size: A5 portrait;
    margin: 10mm;
  }
  @media print {
    .doc-inner {
      padding: 0;
    }
    body {
      background: white;
      padding: 0;
      color: black;
      display: block;
      min-height: 0;
    }
    .print-toolbar {
      display: none;
    }
    .pocket-sheet {
      padding: 0;
      max-width: none;
      background: white;
      box-shadow: none;
    }
    .pocket-heading {
      grid-template-columns: 1fr 23mm;
      gap: 4mm;
      padding-bottom: 3mm;
    }
    h1 {
      font-size: 21pt;
    }
    .subtitle {
      font-size: 11pt;
      margin-bottom: 2mm;
    }
    .eyebrow,
    .record {
      font-size: 7pt;
      margin-bottom: 2mm;
    }
    .pocket-rules {
      margin: 2mm 0;
    }
    .pocket-rules li {
      padding: 2.4mm 0;
      gap: 3mm;
    }
    .rule-number {
      font-size: 17pt;
      min-width: 7mm;
      color: black;
    }
    h2 {
      font-size: 10pt;
      margin-bottom: 1mm;
    }
    .pocket-rules p {
      font-size: 8.5pt;
      line-height: 1.35;
    }
    footer {
      padding-top: 2mm;
      font-size: 6.5pt;
    }
    footer a {
      text-decoration: none;
    }
    footer a::after {
      content: none;
    }
  }
</style>
